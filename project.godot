; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot 4 2D Card Game"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

AudioManager="*res://scripts/audio_manager.gd"
CardDatabase="*res://scripts/card_database.gd"
PlayerCardCollection="*res://scripts/player_card_collection.gd"
RunManager="*res://scripts/run_manager.gd"
RewardManager="*res://scripts/reward_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
LanguageManager="*res://scripts/LanguageManager.gd"
RelicManager="*res://scripts/relic_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
