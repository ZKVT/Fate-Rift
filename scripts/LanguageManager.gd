func _ready() -> void:
	_install_content_translations()
	load_language_from_profile()


func set_language(lang: String) -> void:
	var normalized := _normalize_language(lang)
	if current_language == normalized:
		return
	current_language = normalized
	save_language_to_profile()
	language_changed.emit()


func get_language() -> String:
	return current_language


func toggle_language() -> void:
	set_language(LANGUAGE_EN if current_language == LANGUAGE_ZH else LANGUAGE_ZH)


func tr_key(key: String) -> String:
	var language_table: Dictionary = translations.get(current_language, {})
	if language_table.has(key):
		return str(language_table[key])

	var fallback_table: Dictionary = translations.get(LANGUAGE_ZH, {})
	if fallback_table.has(key):
		push_warning("[LanguageManager] missing key for %s: %s" % [current_language, key])
		return str(fallback_table[key])

	push_warning("[LanguageManager] missing translation key: " + key)
	return key


func tr_format(key: String, params: Dictionary) -> String:
	var text := tr_key(key)
	for param_key in params.keys():
		text = text.replace("{%s}" % str(param_key), str(params[param_key]))
	return text


func has_key(key: String) -> bool:
	var language_table: Dictionary = translations.get(current_language, {})
	var fallback_table: Dictionary = translations.get(LANGUAGE_ZH, {})
	return language_table.has(key) or fallback_table.has(key)


func get_card_name(card_id: String, upgraded := false, fallback := "") -> String:
	var base := _entity_text("card.%s.name" % card_id, fallback if fallback != "" else card_id)
	return base + "+" if upgraded else base


func get_card_description(card_id: String, upgraded := false, fallback := "") -> String:
	var key := "card.%s.upgraded_desc" % card_id if upgraded else "card.%s.desc" % card_id
	return _entity_text(key, fallback)


func get_relic_name(relic_id: String, fallback := "") -> String:
	return _entity_text("relic.%s.name" % relic_id, fallback if fallback != "" else relic_id)


func get_relic_description(relic_id: String, fallback := "") -> String:
	return _entity_text("relic.%s.desc" % relic_id, fallback)


func get_enemy_name(enemy_id: String, fallback := "") -> String:
	return _entity_text("enemy.%s.name" % enemy_id, fallback if fallback != "" else enemy_id)


func get_event_title(event_id: String, fallback := "") -> String:
	return _entity_text("event.%s.title" % event_id, fallback if fallback != "" else event_id)


func get_status_name(status_id: String, fallback := "") -> String:
	return _entity_text("status.%s.name" % status_id, fallback if fallback != "" else status_id)


func _entity_text(key: String, fallback: String) -> String:
	var language_table: Dictionary = translations.get(current_language, {})
	if language_table.has(key):
		return str(language_table[key])

	var zh_table: Dictionary = translations.get(LANGUAGE_ZH, {})
	if current_language == LANGUAGE_ZH and zh_table.has(key):
		return str(zh_table[key])

	if fallback != "":
		return fallback

	push_warning("[LanguageManager] missing translation key: " + key)
	return key


func load_language_from_profile() -> void:
	var save_manager := get_node_or_null("/root/SaveManager")
	if save_manager != null and save_manager.has_method("get_profile_language"):
		current_language = _normalize_language(save_manager.get_profile_language())
	else:
		current_language = LANGUAGE_ZH


func save_language_to_profile() -> void:
	var save_manager := get_node_or_null("/root/SaveManager")
	if save_manager != null and save_manager.has_method("set_profile_language"):
		save_manager.set_profile_language(current_language)


func _normalize_language(lang: String) -> String:
	if lang == LANGUAGE_EN:
		return LANGUAGE_EN
	return LANGUAGE_ZH


