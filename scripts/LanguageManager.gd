func _install_event_dictionary(language: String, events: Dictionary) -> void:
	var entries := {}
	for event_id in events.keys():
		var values: Array = events[event_id] as Array
		entries["event.%s.title" % event_id] = values[0]
		entries["event.%s.desc" % event_id] = values[1]
		for index in range(3):
			entries["event.%s.choice_%d" % [event_id, index + 1]] = values[2 + index]
			entries["event.%s.result_%d" % [event_id, index + 1]] = values[5 + index]
	_add_translations(language, entries)
